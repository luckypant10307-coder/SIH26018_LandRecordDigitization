# Copy to .env and fill in. NEVER commit .env - it is in .gitignore, and it
# should stay there. This file is the committed template: names and comments,
# no values.
#
# run.py reads .env into the environment before importing any backend module,
# because several of them decide at import time whether an optional service is
# available. A variable already set in the real environment always wins, so a
# deployment can inject secrets its own way (systemd, a container runtime, a
# CI secret store) and ignore this file entirely - which is the right thing to
# do in production. A .env file is a development convenience, not a vault.
#
# On a shared machine, restrict the file to your own account:
#   Windows:  icacls .env /inheritance:r /grant:r "%USERNAME%:(F)"
#   Linux:    chmod 600 .env

# --------------------------------------------------------------------------
# Bhashini (ULCA) - Indic script transliteration for place names
# --------------------------------------------------------------------------
# Needed only to match Devanagari village/district names against the Latin
# administrative master. Without it the pipeline still runs; Indic place names
# simply do not resolve, and run.py --check says so.
# Get these from https://bhashini.gov.in -> your project.
BHASHINI_PROJECT_ID=
BHASHINI_UDYAT_KEY=
BHASHINI_INFERENCE_KEY=

# Place names are sent to a third-party (government) service, so this is
# opt-in. Set to 1 to allow it. Anything else leaves transliteration off.
BHASHINI_CONSENT=0

# Optional overrides. The defaults are the MeitY-published pipeline.
# BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
# BHASHINI_TIMEOUT_SECONDS=45
# BHASHINI_MAX_BATCH=25

# --------------------------------------------------------------------------
# Language-model field suggestions (optional)
# --------------------------------------------------------------------------
# Used only for fields the rule-based extractor could not read. Document text
# leaves the machine, so this is opt-in too and OFF unless consent is set.
# Set exactly one provider key.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# NVIDIA_API_KEY=
LLM_FIELD_EXTRACTION_CONSENT=0

# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPENAI_MODEL=gpt-4o-mini
# LLM_REQUEST_TIMEOUT_SECONDS=90
